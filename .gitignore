# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# ブラウザ段の実行時出力（T-03。失敗時のスクリーンショットと添付。再現できるので残さない）
__screenshots__/
/.vitest-attachments/

# next.js
/.next/
/.next-check/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# DBバックアップ（本番の実データを含むため決してコミットしない）
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor backups
*.un~

# allow env template
!.env.example

# Claude Code ローカル状態
.claude/scheduled_tasks.lock

# スキルの評価スクラッチ（skill-creator の workspace。出力・ログ・ベンチマークは残さない）
.claude/skills/*-workspace/

# Playwright MCP の作業出力（ページスナップショット・コンソールログ。実データが写るためコミットしない）
.playwright-mcp/

# 設計ブレスト用モック（superpowers ブレストの一時ファイル）
.superpowers/
